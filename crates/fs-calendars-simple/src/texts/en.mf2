# The words of the window of FreeSynergy Calendars, English (ADR 0057: MessageFormat 2). Every id needs a German twin in de.mf2.
app-name = FreeSynergy Calendars
app-tagline = Goal: Your dates in one place: month, week, day and agenda, one colour per calendar. The times are kept in UTC with their zone, a date stays a date.
soon = coming soon
date-style = en
menu-program = Calendars
menu-new = New appointment
menu-search = Search
menu-import = Import calendar
status-ready = Ready
title-preview = (preview)
screen-all = All calendars
screen-private = Private
screen-work = Work
screen-family = Family
screen-holidays = Holidays
screen-start = Start
screen-coming = What comes
preview-title = Preview
preview-text = These are example data so you can see what FreeSynergy Calendars will look like. None of it is real; nothing is saved or sent. Real appointments appear here as soon as the server provides them.
preview-hidden-text = The example is hidden. Real appointments appear here as soon as the server provides them.
preview-hide = Hide example
preview-show = Show example
empty-title = No appointments yet
empty-text = As soon as appointments exist, they appear here in the month, week and day views. Until then there is nothing to show; nothing is hidden.
